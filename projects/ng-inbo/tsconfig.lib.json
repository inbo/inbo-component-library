/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    // Keep the published build hermetic: without this, every @types/* package in
    // node_modules is pulled in, so a devDependency like @types/mdx can break it.
    "types": [],
    "noUnusedLocals": false,
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": ["src/**/*.ts"]
}
