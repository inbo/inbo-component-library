{
  "name": "@inbo/ng-inbo",
  "version": "3.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/inbo/inbo-component-library.git",
    "directory": "projects/ng-inbo"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "schematics": "./schematics/collection.json",
  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "copyfiles ./schematics/*/schema.json ./schematics/*/files/** ./schematics/collection.json ../../dist/ng-inbo/"
  },
  "ng-add": {
    "save": "devDependencies"
  },
  "peerDependencies": {
    "@angular/cdk": ">=20.2.4 <21.0.0",
    "@angular/common": ">=20.3.25 <21.0.0",
    "@angular/core": ">=20.3.25 <21.0.0",
    "@angular/material": ">=20.2.4 <21.0.0",
    "date-fns": "2.30.0",
    "lodash-es": "4.18.1",
    "ngx-pipes": "3.2.2"
  },
  "dependencies": {
    "proj4": "2.19.10",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "copyfiles": "file:../../node_modules/copyfiles",
    "typescript": "file:../../node_modules/typescript"
  }
}
