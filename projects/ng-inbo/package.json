{
  "name": "@inbo/ng-inbo",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inbo/inbo-component-library.git",
    "directory": "projects/ng-inbo"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "schematics": "./schematics/collection.json",
  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "copyfiles ./schematics/*/schema.json ./schematics/*/files/** ./schematics/collection.json ../../dist/ng-inbo/"
  },
  "ng-add": {
    "save": "devDependencies"
  },
  "peerDependencies": {
    "@angular/cdk": ">=21.0.0 <22.0.0",
    "@angular/common": ">=21.0.0 <22.0.0",
    "@angular/core": ">=21.0.0 <22.0.0",
    "@angular/material": ">=21.0.0 <22.0.0",
    "date-fns": ">=2.29.3 <3.0.0",
    "lodash-es": ">=4.17.21 <5.0.0",
    "ngx-pipes": ">=3.2.2 <4.0.0"
  },
  "dependencies": {
    "ol": "9.1.0",
    "proj4": "2.19.10",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "copyfiles": "file:../../node_modules/copyfiles",
    "typescript": "file:../../node_modules/typescript"
  }
}
