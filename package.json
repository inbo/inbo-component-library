{
  "name": "inbo-component-library-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/inbo/inbo-component-library.git"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "http-proxy-middleware": "3.0.7",
    "ip": "2.0.1",
    "webpack-dev-server": "5.2.6",
    "uuid": "11.1.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve:demo": "ng serve demo-app --port 4201",
    "build": "npm run build:lib",
    "build:lib": "ng build ng-inbo && npm run build-schematics",
    "build:demo": "ng build demo-app",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "build-schematics": "cd projects/ng-inbo && npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test ng-inbo --watch=false --browsers=ChromeHeadlessCI",
    "test:release": "node --test scripts/*.test.mjs",
    "check:peer-ranges": "node scripts/release-validation.mjs peer-ranges",
    "check:pr-title": "node scripts/release-validation.mjs pr-title",
    "release:prepare": "node scripts/release-commands.mjs prepare",
    "release:candidate": "node scripts/release-commands.mjs candidate",
    "release:promote": "node scripts/release-commands.mjs promote",
    "release:reject": "node scripts/release-commands.mjs reject",
    "release:rollback": "node scripts/release-commands.mjs rollback",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "21.2.22",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.22",
    "@angular/platform-browser-dynamic": "21.2.22",
    "@angular/router": "21.2.22",
    "@types/lodash-es": "4.17.12",
    "copyfiles": "2.4.1",
    "date-fns": "2.30.0",
    "lodash-es": "4.18.1",
    "ngx-pipes": "3.2.2",
    "ol": "9.1.0",
    "proj4": "2.19.10",
    "rxjs": "7.8.1",
    "tslib": "2.4.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@johanblumenberg/ts-mockito": "1.0.43",
    "@types/jasmine": "4.0.0",
    "angular-eslint": "^21.2.0",
    "core-js": "3.37.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.4.0",
    "husky": "^9.1.7",
    "jasmine-core": "4.2.0",
    "karma": "6.4.3",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-packagr": "21.2.7",
    "prettier": "3.5.3",
    "release-please": "17.11.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
